[Unit]
Description=Life Assistant agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=life-assistant
Group=life-assistant
WorkingDirectory=/opt/life-assistant/backend
EnvironmentFile=/etc/life-assistant/life-assistant.env
ExecStart=/opt/life-assistant/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 443 --ssl-keyfile /etc/life-assistant/tls/key.pem --ssl-certfile /etc/life-assistant/tls/cert.pem
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=2
ReadWritePaths=/var/lib/life-assistant /etc/life-assistant

[Install]
WantedBy=multi-user.target
