[Unit]
Description=Life Assistant agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=life-assistant
Group=life-assistant
WorkingDirectory=/opt/life-assistant/backend
EnvironmentFile=/etc/life-assistant/life-assistant.env
ExecStart=/opt/life-assistant/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
ReadWritePaths=/var/lib/life-assistant

[Install]
WantedBy=multi-user.target
