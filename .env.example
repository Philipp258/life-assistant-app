# Life Assistant — copy to .env and edit as needed.

# Runtime environment: dev | prod
ENV=dev

# SQLite path. Defaults to <repo>/data/life_assistant.db if unset.
# DATABASE_URL=sqlite:////absolute/path/to/life_assistant.db

# When true, FastAPI also serves the built frontend from frontend/dist.
# In dev you normally leave this false and run Vite on :5173.
SERVE_FRONTEND=false

# --- Chat provider ---
# Configured in the UI under Agent → Settings on first run. Stored in the
# DB encrypted under SESSION_SECRET. There is no env-var fallback.

# --- Observability (optional) ---
# Langfuse tracing (OpenTelemetry). All three required to enable; leave
# any blank to disable observability entirely — no setup runs and no
# spans are exported.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry error/performance monitoring. Leave blank to disable.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_PROFILES_SAMPLE_RATE=0
#
# Frontend Sentry config is baked into the Vite build.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=dev
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# --- Auth ---
# Signs the session cookie. Required. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Rotating this value invalidates all existing sessions.
SESSION_SECRET=

# Set the login password with `make set-password PASSWORD=<pw>`. The
# bcrypt hash lives on the singleton user row — there is no env var.

# --- Production deploy (set on the VPS, not locally) ---
# Production also wants:
#   SERVE_FRONTEND=true
#   DATABASE_URL=sqlite:////var/lib/life-assistant/data/life_assistant.db
